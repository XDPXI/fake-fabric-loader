{
  "schema_version": 1,
  "quilt_loader": {
    "group": "net.fabricmc",
    "id": "fabricloader",
    "version": "${version}",
    "metadata": {
      "name": "Fabric Loader",
      "description": "Reports a different Fabric Loader version to other mods."
    },
    "intermediate_mappings": "net.fabricmc:intermediary",
    "depends": [
      {
        "id": "minecraft"
      }
    ]
  },
  "minecraft": {
    "environment": "*"
  },
  "experimental_quilt_loader_plugin": {
    "class": "dev.xdpxi.fakefabricloader.QuiltFabricLoaderPlugin",
    "packages": ["dev.xdpxi.fakefabricloader"]
  }
}
